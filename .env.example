# ==============================================================================
# INFIAX STATUS MONITOR — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and adjust values for your deployment.
# Do NOT commit your real .env file to version control.
# Permissions on .env must be 0600 (chmod 600 .env).
# ==============================================================================

# --- Project Metadata ---
COMPOSE_PROJECT_NAME=infiax-status-monitor
TZ=Asia/Colombo

# --- Domain Configuration ---
# Public FQDNs pointing via DNS A records to this server's public IPv4 address.
# Note: Use hyphens, never underscores (e.g., dev-monitor.example.com).
STATUS_DOMAIN=status.example.com
BESZEL_DOMAIN=monitor.example.com

# Optional email for Let's Encrypt ACME registration and expiry notices
ACME_EMAIL=admin@example.com

# Expected public IPv4 of this VPS (leave blank or adjust to your server IPv4)
SERVER_IPV4=203.0.113.10

# --- Container Image Versions (Pinned for Production Stability) ---
CADDY_IMAGE=caddy:2.11.7-alpine
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:2.5.6-slim
BESZEL_HUB_IMAGE=henrygd/beszel:0.21.0
BESZEL_AGENT_IMAGE=henrygd/beszel-agent:0.21.0

# --- Beszel Hub & Agent Configuration ---
# APP_URL is used by Beszel Hub for notification links and agent config generation
BESZEL_APP_URL=https://monitor.example.com

# Unix domain socket shared between Beszel Hub and Beszel Agent (avoids exposing TCP 45876)
BESZEL_AGENT_LISTEN=/beszel_socket/beszel.sock

# Public SSH key (ssh-ed25519 ...) and token generated by Beszel Hub when adding the system
BESZEL_AGENT_KEY=
BESZEL_AGENT_TOKEN=
BESZEL_HUB_URL=https://monitor.example.com

# Disable periodic outbound Docker Hub image update polling to save CPU/RAM on micro VPS
BESZEL_DOCKER_IMAGE_CHECK=false

# Memory calculation mode for Beszel Agent ('default' matches free, 'htop' matches htop)
BESZEL_MEM_CALC=default

# --- Resource Limits (Tuned for ~1 GiB RAM + 4 GiB Swap Micro VPS) ---
# Soft/hard limits prevent runaway memory exhaustion while allowing safe startups & migrations
CADDY_MEM_LIMIT=128m
UPTIME_KUMA_MEM_LIMIT=384m
UPTIME_KUMA_NODE_MAX_OLD_SPACE=256
BESZEL_HUB_MEM_LIMIT=192m
BESZEL_AGENT_MEM_LIMIT=128m

# --- Telegram Notification Reference (Stored with 0600 permissions) ---
# Used by 'monitor.sh' Telegram test utility and Shoutrrr URL helper.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Backup Retention ---
BACKUP_RETENTION_COUNT=7
