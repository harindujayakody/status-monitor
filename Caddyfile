# ==============================================================================
# INFIAX STATUS MONITOR — CADDY REVERSE PROXY CONFIGURATION
# ==============================================================================
# Automatically provisions and renews Let's Encrypt / ZeroSSL TLS certificates.
# Routes HTTPS traffic to private Docker bridge containers:
#   - {$STATUS_DOMAIN} -> uptime-kuma:3001
#   - {$BESZEL_DOMAIN} -> beszel:8090
# ==============================================================================

{
	email {$ACME_EMAIL:admin@example.com}
	admin 127.0.0.1:2019
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate"
		-Server
	}

	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond "User-agent: *
Disallow: /
" 200
	}
}

# ------------------------------------------------------------------------------
# Uptime Kuma — Public Status Page & Monitoring Dashboard
# ------------------------------------------------------------------------------
{$STATUS_DOMAIN:status.example.com} {
	import security_headers

	encode zstd gzip

	reverse_proxy uptime-kuma:3001 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 360s
		}
	}

	log {
		output file /var/log/caddy/status-access.log {
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 168h
		}
		format json
	}
}

# ------------------------------------------------------------------------------
# Beszel Hub — Server Resource & Container Metrics Dashboard
# ------------------------------------------------------------------------------
{$BESZEL_DOMAIN:monitor.example.com} {
	import security_headers

	encode zstd gzip

	request_body {
		max_size 10MB
	}

	reverse_proxy beszel:8090 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 360s
		}
	}

	log {
		output file /var/log/caddy/beszel-access.log {
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 168h
		}
		format json
	}
}
